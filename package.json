{
  "name": "stratoverlay",
  "version": "0.3.1",
  "description": "Step-by-step strategy overlay for Roblox Tower Defense Simulator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "private": true,
  "productName": "StratOverlay",
  "author": "aid5555",
  "build": {
    "appId": "com.aid5555.stratoverlay",
    "productName": "StratOverlay",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "StratOverlay-${version}-mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "StratOverlay-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "StratOverlay-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "aid5555",
      "repo": "StratOverlay",
      "releaseType": "release"
    }
  }
}
